meta {
  name: Get Task By ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tasks/task-1
  body: none
  auth: none
}

params:query {
  ~include: user
}

docs {
  task-1 pertenece al administrador (seeder): usa "Login Admin". Con "Login User" prueba task-3.
  Una tarea ajena devuelve 403 y una eliminada (soft delete) 404, salvo con includeDeleted=true.
}
