meta {
  name: MFA Disable
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/auth/mfa/disable
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "password123",
    "code": "123456"
  }
}

docs {
  Desactiva el 2FA con la contraseña y un código TOTP (o recoveryCode en su lugar).
}
