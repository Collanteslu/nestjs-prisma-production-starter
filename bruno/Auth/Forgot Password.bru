meta {
  name: Forgot Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "ana@example.com"
  }
}

docs {
  Pide un enlace de recuperación. Responde 202 exista o no la cuenta. En desarrollo (MAIL_TRANSPORT=log) el enlace con el token sale en el log del servidor.
}
