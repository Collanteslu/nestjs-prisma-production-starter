meta {
  name: Reset Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "PEGA_AQUI_EL_TOKEN_DEL_CORREO",
    "password": "new-password-123"
  }
}

docs {
  Cambia la contraseña con el token recibido por correo (un solo uso) y cierra todas las sesiones.
}
