meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "ana@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200 && res.body.accessToken) {
    bru.setVar("token", res.body.accessToken);
    bru.setVar("refreshToken", res.body.refreshToken);
    if (res.body.sessionId) {
      bru.setVar("sessionId", res.body.sessionId);
    }
  }
}

docs {
  Inicia sesión como usuario estándar (Ana, usuario demo del seeder, solo en desarrollo).
  Límite: 10 intentos/min por IP y bloqueo de la cuenta tras 5 contraseñas incorrectas (15 min).
}
