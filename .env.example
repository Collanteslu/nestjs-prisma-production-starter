# Configuración del Servidor
PORT=3011
NODE_ENV=development

# Nivel de autenticación (ver AGENTS.md, "Authentication modes"):
#   none  = sin usuarios ni auth: solo el recurso público de ejemplo (/api/tasks)
#   basic = usuarios, login, sesiones, roles y auditoría (sin email, recuperación ni 2FA)
#   full  = basic + verificación de email, recuperación de contraseña y 2FA TOTP (por defecto)
# AUTH_MODE=full

# Secretos JWT (OBLIGATORIOS salvo con AUTH_MODE=none: la app no arranca si están vacíos)
# Genera dos valores distintos con:  openssl rand -base64 48
# En producción: mínimo 32 caracteres y JWT_SECRET distinto de JWT_REFRESH_SECRET.
# Nunca reutilices los secretos de desarrollo en producción.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Base de Datos (SQLite Local por defecto)
DATABASE_URL=file:./dev.db

# Configuración Opcional para Turso LibSQL (Cloud / Edge)
# Si se definen, la API se conecta automáticamente a Turso en lugar del archivo SQLite local.
# TURSO_DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=tu-turso-auth-token

# Proxy inverso (Cloudflare, Coolify, Traefik, Nginx)
# Habilitar solo cuando la API esté detrás de un reverse proxy de confianza para rate limiting real por IP.
# ⚠ En producción: si la API además es accesible DIRECTAMENTE, un cliente puede falsificar
#   X-Forwarded-For y eludir/compartir límites. Restringe la red al proxy, haz que el proxy
#   SOBRESCRIBA la cabecera y verifica la topología por despliegue (AGENTS.md, "Despliegue
#   con proxy" — incluye pruebas automatizadas de ambas posturas).
TRUST_PROXY=false
# Cuántos proxies de confianza hay delante (1 = Traefik/Nginx; 2 = p. ej. Cloudflare + Traefik).
# Solo se lee X-Forwarded-For y desde la derecha: CF-Connecting-IP y X-Real-IP se ignoran
# porque un cliente puede falsificarlos.
# TRUST_PROXY_HOPS=1

# Bootstrap del Administrador Inicial en Producción (Opcional; no admitido con AUTH_MODE=none)
# Si la base de datos está vacía en NODE_ENV=production, creará este usuario admin (contraseña de 8 a 72 caracteres)
# ADMIN_EMAIL=admin@tudominio.com
# ADMIN_PASSWORD=cambia-esta-contraseña-12345

# Orígenes permitidos por CORS separados por comas (por defecto "*" fuera de producción y ninguno en producción).
# En producción "*" se RECHAZA salvo decisión explícita con CORS_ALLOW_WILDCARD=true.
# CORS_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com
# CORS_ALLOW_WILDCARD=false

# Documentación /docs y /openapi.json (por defecto activa salvo en producción)
# ENABLE_DOCS=false

# Rate limiting por IP (peticiones por ventana): login y refresh por minuto, registro por hora
# LOGIN_RATE_LIMIT_MAX=10
# REFRESH_RATE_LIMIT_MAX=30
# REGISTER_RATE_LIMIT_MAX=5
# Solo AUTH_MODE=full: recuperación/verificación por hora (reset x2, verify-email x3) y endpoints MFA por minuto
# RECOVERY_RATE_LIMIT_MAX=10
# MFA_RATE_LIMIT_MAX=10

# Segundos en los que reutilizar un refresh token recién rotado se trata como refresh concurrente
# (fuera de esa ventana se considera robo del token y se revoca la sesión)
# REFRESH_REUSE_GRACE_SECONDS=10

# Qué hace el limitador si la base de datos de contadores no está disponible:
#   local (defecto) = las rutas críticas (login, registro, refresh, recuperación, MFA)
#                     siguen protegidas con una ventana temporal en proceso; el resto se abre
#   open            = todo se abre (máxima disponibilidad; era el comportamiento anterior)
# Ambos modos registran y cuentan cada fallo en los logs/métricas del RateLimitGuard.
# RATE_LIMIT_ON_DB_FAILURE=local

# Nivel de log de la aplicación (trace, debug, info, warn, error, fatal, silent)
# LOG_LEVEL=info

# Correo saliente para recuperación de contraseña y verificación de email (solo AUTH_MODE=full).
# MAIL_TRANSPORT: none (por defecto en producción), log (imprime el mensaje con el token: SOLO
# desarrollo — la app rechaza MAIL_TRANSPORT=log con NODE_ENV=production porque escribiría tokens
# de un solo uso en el flujo de logs) o smtp
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtps://usuario:clave@smtp.tudominio.com:465
# MAIL_FROM="Mi API <no-reply@tudominio.com>"
# URL del frontend para los enlaces de los correos (/reset-password?token=..., /verify-email?token=...)
# Obligatoria (y con https) en producción cuando AUTH_MODE=full y MAIL_TRANSPORT=smtp
# APP_URL=https://app.tudominio.com
# PASSWORD_RESET_TTL_MINUTES=60
# EMAIL_VERIFY_TTL_HOURS=24
# Exigir email verificado para iniciar sesión (requiere AUTH_MODE=full y MAIL_TRANSPORT=smtp)
# REQUIRE_EMAIL_VERIFICATION=false
# 2FA (solo AUTH_MODE=full). Clave (>= 32 caracteres) con la que se cifran los secretos TOTP.
# OBLIGATORIA en producción con AUTH_MODE=full (la app no arranca sin ella): sin clave dedicada
# los secretos se cifran derivando de JWT_SECRET y rotar JWT_SECRET dejaría sin acceso a todos
# los 2FA inscritos. Genera una con: openssl rand -base64 48
# Procedimiento de rotación en AGENTS.md ("Rotación de claves MFA").
# MFA_ENCRYPTION_KEY=
# Clave anterior: solo durante una rotación; permite descifrar los secretos ya guardados
# mientras se re-cifran con la nueva clave (nunca se usa para cifrar).
# MFA_ENCRYPTION_KEY_PREVIOUS=
# MFA_ISSUER=Mi API

# Intentos fallidos antes de bloquear una cuenta y minutos de bloqueo
# LOGIN_LOCKOUT_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15

# Días que se conservan los registros de auditoría (0 = para siempre)
# AUDIT_RETENTION_DAYS=90
